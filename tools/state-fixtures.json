{
  "defaults": {
    "authorized": true,
    "availability": "present",
    "accepted": false,
    "accepted_validated": {},
    "accepted_epoch": 0,
    "known_source": { "rate": 1 },
    "invalidation_epoch": 0,
    "request_active": false
  },
  "scenarios": [
    {
      "name": "first load without a cached value",
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "first load times out",
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_failed", "expected": "Broken" }
      ]
    },
    {
      "name": "source advance during refresh then cancel",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "source_advanced", "expected": "Refreshing" },
        { "event": "refresh_cancelled", "expected": "Stale" }
      ]
    },
    {
      "name": "superseding request settles at the new head",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "source_advanced", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "superseded reply is discarded",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "source_advanced", "expected": "Stale" },
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "source_advanced", "expected": "Refreshing" },
        { "event": "superseded_reply", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "timeout after a cached value",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_failed", "expected": "Broken" }
      ]
    },
    {
      "name": "grant change during a request",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "grant_revoked", "expected": "Denied" },
        { "event": "grant_issued", "expected": "Stale" },
        { "event": "obsolete_reply", "expected": "Stale" },
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "grant issued without a cached value",
      "events": [
        { "event": "grant_revoked", "expected": "Denied" },
        { "event": "grant_issued", "expected": "Broken" },
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "source notification while broken with a provider",
      "events": [
        { "event": "source_advanced", "expected": "Broken" },
        { "event": "refresh_requested", "expected": "Refreshing" }
      ]
    },
    {
      "name": "late completion cannot reverse a denial",
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "grant_revoked", "expected": "Denied" },
        { "event": "obsolete_reply", "expected": "Denied" }
      ]
    },
    {
      "name": "provider loss and recovery require revalidation",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "provider_lost", "expected": "Broken" },
        { "event": "provider_recovered", "expected": "Stale" },
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_succeeded", "expected": "Current" }
      ]
    },
    {
      "name": "provider loss cannot change a denied state",
      "events": [
        { "event": "grant_revoked", "expected": "Denied" },
        { "event": "provider_lost", "expected": "Denied" }
      ]
    },
    {
      "name": "source notification during Current",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "source_advanced", "expected": "Stale" }
      ]
    },
    {
      "name": "cancel without a source advance",
      "facts": {
        "accepted": true,
        "accepted_validated": { "rate": 1 }
      },
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_cancelled", "expected": "Current" }
      ]
    },
    {
      "name": "refresh failure without a cached value",
      "events": [
        { "event": "refresh_requested", "expected": "Refreshing" },
        { "event": "refresh_failed", "expected": "Broken" }
      ]
    }
  ]
}