{
  "gitignore": true,
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD029": { "style": "ordered" },
    "MD033": false
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
